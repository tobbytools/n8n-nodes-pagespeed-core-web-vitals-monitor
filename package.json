{
	"name": "n8n-nodes-pagespeed-core-web-vitals-monitor",
	"version": "0.1.0",
	"description": "n8n community node: bulk Google PageSpeed Insights + real-user Core Web Vitals (LCP, INP, CLS) for many URLs or a sitemap, with trends, top fixes and regression alerts, via the Apify PageSpeed & Core Web Vitals Monitor Actor.",
	"keywords": [
		"n8n-community-node-package",
		"n8n-nodes",
		"n8n",
		"pagespeed",
		"pagespeed-insights",
		"core-web-vitals",
		"lighthouse",
		"crux",
		"web-vitals",
		"seo",
		"performance",
		"monitoring",
		"apify",
		"sitemap"
	],
	"license": "MIT",
	"author": {
		"name": "tobbytools",
		"email": "tobbytools.dev@gmail.com",
		"url": "https://github.com/tobbytools"
	},
	"engines": {
		"node": ">=18.10"
	},
	"packageManager": "npm@10.8.2",
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "WEBHOOK_URL=https://localhost:5678 jest --config jest.config.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ApifyApi.credentials.js",
			"dist/credentials/ApifyOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/ApifyPagespeedCoreWebVitalsMonitor/ApifyPagespeedCoreWebVitalsMonitor.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.0.1",
		"apify-client": "^2.16.0",
		"chalk": "^5.6.0",
		"eslint": "^9.32.0",
		"glob": "^11.0.3",
		"gulp": "^4.0.2",
		"jest": "^29.7.0",
		"nock": "^14.0.5",
		"prettier": "^3.6.2",
		"sharp": "^0.34.2",
		"ts-jest": "^29.3.2",
		"typescript": "5.9.2"
	},
	"homepage": "https://apify.com/tobbyb/pagespeed-core-web-vitals-monitor",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tobbytools/n8n-nodes-pagespeed-core-web-vitals-monitor.git"
	},
	"bugs": {
		"url": "https://apify.com/tobbyb/pagespeed-core-web-vitals-monitor/issues/open"
	}
}
